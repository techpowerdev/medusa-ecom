# คัดลอกเป็น apps/backend/.env แล้วแก้ค่า — ห้าม commit .env
# ค่า default ด้านล่างตรงกับ docker-compose.yml ที่ root (`docker compose up -d`)
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa
# Redis modules ของ Medusa ใช้ REDIS_URL เฉพาะ NODE_ENV=production (OPS-2) — dev/test ใช้ in-memory
REDIS_URL=redis://localhost:6379
# สร้างค่าสุ่มยาวๆ เช่น `openssl rand -hex 32` — ห้ามใช้ค่าเดียวกันใน prod
JWT_SECRET=change-me
COOKIE_SECRET=change-me
# คีย์เข้ารหัส MFA ของ Auth module (create-medusa-app สร้างให้ใน .env) — `openssl rand -hex 32`
AUTH_MFA_ENCRYPTION_KEY=
# อีเมล (Resend) — ว่างไว้ = ใช้ provider `local` ของ Medusa (log แทนการส่งจริง)
# ถ้าตั้ง RESEND_API_KEY ต้องตั้ง RESEND_FROM_EMAIL ด้วย (domain ที่ verify ใน Resend แล้ว)
# OPS-7: NODE_ENV=production ขาดตัวใดตัวหนึ่ง = บูตไม่ขึ้น (ยกเว้น ALLOW_TEST_PROVIDERS=true)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# URL ของ storefront สำหรับลิงก์ในอีเมล (GB-4: ลิงก์ชำระเงิน /account/orders/:id/pay) — ว่าง = ลิงก์เป็น path อย่างเดียว
# OPS-7 (AC-17): production ต้องเป็น URL http(s) ไม่งั้นบูตไม่ขึ้น; นอก prod ว่าง = warning ครั้งเดียวตอนบูต
STOREFRONT_URL=http://localhost:8000
# ADR-010: "true" = ยอมให้ production ใช้ provider ทดสอบ (อีเมล local, seed เปิด pp_system_default)
# สำหรับ CI/staging เท่านั้น — ห้ามตั้งใน prod (`pnpm --filter backend check:go-live` จะไม่ผ่าน)
# ALLOW_TEST_PROVIDERS=

# worker mode ของ Medusa (OPS-1) — dev ไม่ต้องตั้ง (default `shared`: HTTP + jobs/subscribers ใน process เดียว)
# prod: server → MEDUSA_WORKER_MODE=server, DISABLE_MEDUSA_ADMIN=false; worker → worker, true
# MEDUSA_WORKER_MODE=shared
# DISABLE_MEDUSA_ADMIN=false

# คีย์เข้ารหัส code/PIN ของ e-voucher (AES-256-GCM) — 64 hex chars: `openssl rand -hex 32`
# ห้ามเปลี่ยน/ทำหายหลัง import code แล้ว (จะถอดรหัส code เดิมไม่ได้)
EVOUCHER_ENCRYPTION_KEY=
# mailbox เดียวที่รับอีเมลแจ้ง admin ของ e-voucher (low-stock, สรุป code ใกล้หมดอายุที่ถูก void)
# ว่าง = job รายวันยัง void ตามปกติ แต่ log warning และข้ามการส่งอีเมล
EVOUCHER_ADMIN_EMAIL=

# AF-2 (spec 05): secret ลงชื่อ token ของลิงก์ affiliate (cookie `aff` → cart metadata.affiliate_token)
# `openssl rand -hex 32` — ว่าง = ลิงก์ /r/<code> ยัง redirect ได้แต่ไม่ตั้ง cookie (ไม่มี attribution)
# OPS-7 (AC-13): production ว่าง = บูตไม่ขึ้น
# เปลี่ยนค่าแล้ว token เดิมใน cookie/cart ที่ยังไม่สั่งซื้อจะใช้ไม่ได้
AFFILIATE_TOKEN_SECRET=

# Stripe (spec 06, PAY-1) — dev ใช้ test key (sk_test_…) เท่านั้น
# ไม่มีตัวแปรนี้เลย = backend บูตไม่ขึ้น; มีแต่ค่าว่าง (แบบบรรทัดด้านล่าง) = บูตได้ แต่จะพังตอนเรียก Stripe
# (สร้าง payment session ฯลฯ) และ webhook จะตรวจ signature ไม่ผ่านถ้า STRIPE_WEBHOOK_SECRET ว่าง
# integration test ไม่ต้องตั้ง — integration-tests/setup.js ใส่ค่า dummy ให้ (Stripe ถูก mock)
STRIPE_API_KEY=
# local: `stripe listen --print-secret`; prod: signing secret ของ webhook endpoint ใน Stripe dashboard
STRIPE_WEBHOOK_SECRET=
# PAY-6b (spec 06 กฎข้อ 7D, ADR-015): อีเมลรับ alert PAYMENT_WEBHOOK_SESSION_NOT_FOUND (เงินถูกตัดแต่ไม่มี order)
# แยกจาก EVOUCHER_ADMIN_EMAIL (ตั้งค่าเดียวกันได้) ว่าง = ยัง log error แต่ log warning และข้ามการส่งอีเมล
OPS_ALERT_EMAIL=
# prod (OPS-2, docs/ops/production.md) — ไม่ตั้ง = default ของ Medusa (pool ของ knex, file-local)
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=20
# S3_BUCKET=            # ตั้งแล้วจะใช้ provider file-s3 ต้องตั้งตัวอื่นด้านล่างด้วย
# S3_REGION=
# S3_FILE_URL=          # URL สาธารณะของไฟล์ (โดเมน CDN หน้า bucket)
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ใช้โดย medusa-test-utils (integration tests) เพื่อสร้าง database แยกต่อ test suite
DB_HOST=localhost
DB_USERNAME=medusa
DB_PASSWORD=medusa

# admin user ที่ `pnpm --filter backend seed` สร้าง — SEED_ADMIN_PASSWORD ว่าง = ข้ามการสร้าง admin
# ตั้งรหัสเองใน .env (เช่น `openssl rand -base64 24`) ไม่มีรหัสตัวอย่างในไฟล์นี้ (spec 01 กฎข้อ 18)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
